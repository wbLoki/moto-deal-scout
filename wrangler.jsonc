{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motosnipe",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  // Required by OpenNext so Node built-ins (buffer, crypto, etc.) work on Workers.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret config (safe to commit). Secrets are uploaded with
  // `npm run cf:secrets` / `wrangler secret put` — never put API keys here.
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "APP_BASE_URL": "https://motosnipe.com",
    "ADMIN_EMAIL": "wailbouymaj@gmail.com",
    "ALERT_FROM_EMAIL": "Moto Deal Scout <alerts@motosnipe.com>",
    "AI_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "GITHUB_REPO": "wbLoki/moto-deal-scout",
    "GITHUB_SCAN_WORKFLOW": "scan.yml",
    "GITHUB_DEFAULT_BRANCH": "main"
  },
  "env": {
    "preview": {
      "name": "motosnipe-preview",
      "vars": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "APP_BASE_URL": "https://preview.motosnipe.com",
        "ADMIN_EMAIL": "wailbouymaj@gmail.com",
        "ALERT_FROM_EMAIL": "Moto Deal Scout <alerts@motosnipe.com>",
        "AI_PROVIDER": "gemini",
        "GEMINI_MODEL": "gemini-2.5-flash",
        "GITHUB_REPO": "wbLoki/moto-deal-scout",
        "GITHUB_SCAN_WORKFLOW": "scan.yml",
        "GITHUB_DEFAULT_BRANCH": "main"
      }
    }
  }
}
