{
  "name": "moto-deal-scout",
  "version": "0.1.0",
  "description": "Daily scanner for Moroccan motorcycle marketplaces that scores listings and notifies you only about good deals.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:scan": "tsx src/cli.ts scan",
    "dev:report": "tsx src/cli.ts report",
    "dev:schedule": "tsx src/cli.ts schedule",
    "start": "node dist/cli.js schedule",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fuse.js": "^7.0.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
