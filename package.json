{
  "name": "moto-deal-scout",
  "version": "0.1.0",
  "description": "Daily scanner for Moroccan motorcycle marketplaces that scores listings and notifies you only about good deals.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cli": "tsc -p tsconfig.build.json",
    "cli": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "report": "tsx src/cli.ts report",
    "schedule": "tsx src/cli.ts schedule",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fuse.js": "^7.0.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
