# Copy to .env and fill in as needed. All values have sane defaults except
# DISCORD_WEBHOOK_URL, which is required for the Discord notifier to send anything.

NODE_ENV=development
LOG_LEVEL=info

# --- Database ---
# Local dev: leave DATABASE_URL unset and a file: URL is derived from DATABASE_PATH.
DATABASE_PATH=./data/moto-deal-scout.sqlite
# Production (Vercel): point at your Turso database instead.
# DATABASE_URL=libsql://<your-db>.turso.io
# DATABASE_AUTH_TOKEN=<your-turso-token>

# Optional: path to a JSON file overriding src/config/defaultCriteria.ts.
# CRITERIA_CONFIG_PATH=./config/criteria.json

# Daily scan schedule for the standalone CLI `schedule` command (cron + IANA
# timezone). Default: 8:00 AM Morocco time. On Vercel the schedule instead
# lives in vercel.json and runs in UTC — see the README.
SCAN_CRON_EXPRESSION=0 8 * * *
SCAN_TIMEZONE=Africa/Casablanca

# Politeness delay between requests to the same marketplace.
# GHA daily Avito uses Browser Rendering REST (Free: ≥10000 ms between calls).
SCRAPE_THROTTLE_MS=2000
# Cap Avito pagination (Free BR budget). Unset → source default (3).
# AVITO_MAX_PAGES=1
# Set to false to watch the browser while debugging a scraper (local only).
PLAYWRIGHT_HEADLESS=true

# Cloudflare Browser Rendering REST (GHA / local Avito when no Worker binding).
# Token needs "Browser Rendering - Edit". Account id from the CF dashboard.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Discord webhook URL, e.g. https://discord.com/api/webhooks/<id>/<token>
# DISCORD_WEBHOOK_URL=

# Shared secret protecting /api/scan and /api/report. Set the same value in
# Vercel and it's sent automatically to the cron route. Leave unset locally.
# CRON_SECRET=

# --- Auth (multi-user) ---
# Auth.js session secret. Required in production. Generate: openssl rand -base64 32
# AUTH_SECRET=
# This email gets the admin role on sign-up (manages models, approves requests).
# ADMIN_EMAIL=you@example.com
# OAuth is optional — email+password works without it. Fill a pair to enable a provider.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
